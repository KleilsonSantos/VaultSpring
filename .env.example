# LOCAL DEVELOPMENT ONLY — copy to .env (never commit .env).
#
# These values are intentional lab placeholders for Docker Compose on localhost.
# Do NOT reuse in production or expose Compose ports (5432, 8200, …) to the internet.
# Production/hom: set strong unique secrets via env or Vault; VAULTSPRING_JWT_SECRET is
# required (min 32 chars) and the app fails fast if missing or still a template value.

POSTGRES_DB=users_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpass
POSTGRES_URL=jdbc:postgresql://localhost:5432/users_db

PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=adminpass

VAULT_ADDR=http://127.0.0.1:8200
VAULT_API_ADDR=http://127.0.0.1:8200
# Root or app token after init/unseal — never commit a real token
VAULT_TOKEN=

# Optional: use Vault for datasource (profile prod-vault in Compose)
# SPRING_PROFILES_ACTIVE=prod-vault

# JWT signing secret (min 32 chars) — REQUIRED for prod/hom profiles
VAULTSPRING_JWT_SECRET=
VAULTSPRING_JWT_EXPIRATION_SECONDS=3600

SONAR_JDBC_URL=jdbc:postgresql://postgres:5432/sonarqube
SONAR_JDBC_USERNAME=admin
SONAR_JDBC_PASSWORD=adminpass
